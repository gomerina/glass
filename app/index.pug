doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Dynamic Liquid Glass
    link(rel="stylesheet", href="css/style.css")

  body
    .glass.js-liquid
      span SOS

    canvas#lens
    canvas#noise
    
    svg(width="0" height="0")
      defs
        filter#liquidGlass(
          x="-30%"
          y="-30%"
          width="160%"
          height="160%"
        )
          feImage#lensMap(result="lensMap")
          feImage#noiseMap(result="noiseMap")
          feGaussianBlur(in="noiseMap" stdDeviation="2" result="softNoise")
          feDisplacementMap(
            in="SourceGraphic"
            in2="lensMap"
            scale="60"
            xChannelSelector="R"
            yChannelSelector="G"
            result="lensDistort1"
          )
          feDisplacementMap(
            in="lensDistort1"
            in2="softNoise"
            scale="12"
            xChannelSelector="R"
            yChannelSelector="G"
            result="finalDistort"
          )
    
    script(src="js/main.js")